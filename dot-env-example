# Optional settings used by activate.sh
export GCP_CONFIG_NAME=webhost
export GCP_PROJECT_ID=your-project-id
export GCP_ACCOUNT=you@example.com

# Cloud Run deploy settings
export SERVICE_NAME=webhost
export REGION=asia-northeast1
export SERVICE_ACCOUNT=webhost-app@your-project-id.iam.gserviceaccount.com

# Base URL (used for OAuth redirect)
# For .env use http://localhost:7000.
# For .env-deploy use the Cloud Run custom domain, such as https://webhost.example.com.
export BASE_URL=http://localhost:7000

# Google OAuth (admin)
export GOOGLE_OAUTH_CLIENT_ID=your-client-id
# .env-deploy では実値を書かず、Secret Manager に本番値を保存する。
export GOOGLE_OAUTH_CLIENT_SECRET=secret-manager
export ADMIN_SESSION_TTL_HOURS=12

# Firestore prefix (optional)
export FIRESTORE_PREFIX=dev

# Website update settings
export SITE_HISTORY_BUCKET=your-history-bucket
export SITE_STAGING_DIR=/tmp/webhost-staging
export SITE_SIGNED_URL_SERVICE_ACCOUNT=webhost-app@your-project-id.iam.gserviceaccount.com

# Site defaults
export DEFAULT_ARCHIVE_LIMIT=10
export DEFAULT_UPLOAD_MAX_TOTAL_MB=200
export DEFAULT_UPLOAD_MAX_FILES=2000
export DEFAULT_UPLOAD_MAX_FILE_MB=50
